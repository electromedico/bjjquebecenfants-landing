---
const groups = [
  {
    num: '01',
    ages: '4–6 ans',
    name: 'Petits Tigres',
    text: 'Motricité, écoute et respect des consignes à travers des jeux qui posent — sans qu\'ils s\'en rendent compte — les bases du jiu-jitsu.',
  },
  {
    num: '02',
    ages: '6 ans et plus',
    name: 'Cadets',
    text: 'Positions, contrôles et premières soumissions en douceur, jusqu\'au sparring léger encadré. On y apprend à persévérer, à perdre sans se décourager et à aider son partenaire — avec, pour ceux qui veulent, la porte ouverte vers les cours ados.',
  },
];
---

<section class="section" id="programmes">
  <div class="container">
    <p class="eyebrow">Programmes</p>
    <h2 class="h-1" style="margin-top: 14px; max-width: 16ch;">Deux groupes, un rythme pour chacun.</h2>
    <div class="program-rows">
      {groups.map((g) => (
        <article class="program-row">
          <span class="program-num" aria-hidden="true">{g.num}</span>
          <div class="program-body">
            <p class="program-ages">{g.ages}</p>
            <h3 class="h-3">{g.name}</h3>
            <p>{g.text}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="programs-note">
      Si votre enfant est grand pour son âge, il pourra être dirigé vers le
      groupe principal BJJ Québec —
      <a href="https://bjjquebec.com/" target="_blank" rel="noopener">bjjquebec.com</a>.
    </p>
  </div>
</section>

<style>
  .program-rows {
    margin-top: 40px;
    border-top: 1px solid var(--line-strong);
  }
  .program-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 24px;
    padding-block: 30px;
    border-bottom: 1px solid var(--line-strong);
  }
  .program-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    color: var(--accent);
  }
  .program-ages {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 6px;
  }
  .program-body h3 {
    margin-bottom: 8px;
  }
  .program-body p:last-child {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .programs-note {
    margin: 24px 0 0;
    padding: 14px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink-2);
    font-size: 15px;
    max-width: 72ch;
  }
  .programs-note a {
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  @media (max-width: 640px) {
    .program-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
