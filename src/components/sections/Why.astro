---
const points = [
  {
    title: 'Confiance, pas arrogance',
    text: 'Savoir se défendre sans avoir à se battre : les enfants portent cette assurance à l\'école et partout ailleurs.',
  },
  {
    title: "Gérer l'intimidation, sans violence",
    text: 'Apprendre à désamorcer les conflits avec calme et contrôle — la confiance qui protège, sans jamais lever la main.',
  },
  {
    title: 'Zéro coup, 100 % contrôle',
    text: 'Le jiu-jitsu, c\'est des contrôles et des soumissions — jamais des frappes. Le sport de combat le plus doux pour commencer jeune.',
  },
  {
    title: 'Discipline qui vient d\'eux',
    text: 'Saluer le tapis, écouter, aider les plus petits : des habitudes que les parents remarquent vite à la maison.',
  },
  {
    title: 'Un sport pour tous les gabarits',
    text: 'Ici, la technique bat la force. Petits ou grands, timides ou fonceurs : chacun progresse à son niveau.',
  },
];
---

<section class="section why" id="pourquoi">
  <div class="container">
    <p class="eyebrow">Pourquoi le BJJ</p>
    <h2 class="h-1" style="margin-top: 14px; max-width: 18ch;">Ce que les parents voient changer.</h2>
    <ul class="why-list">
      {points.map((p) => (
        <li>
          <h3 class="h-3">{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--dark);
    color: var(--dark-ink);
  }
  .why .eyebrow {
    color: var(--accent);
  }
  .why-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 48px;
  }
  .why-list li {
    border-top: 1px solid color-mix(in oklab, var(--dark-ink) 22%, transparent);
    padding-top: 18px;
  }
  .why-list h3 {
    margin-bottom: 8px;
  }
  .why-list p {
    opacity: 0.78;
    font-size: 15.5px;
  }
  @media (max-width: 760px) {
    .why-list {
      grid-template-columns: 1fr;
    }
  }
</style>
