---
const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=2376+Rue+Galvani%2C+Qu%C3%A9bec%2C+QC+G1N+4G4';
---

<section class="section where" id="ou-quand">
  <div class="container where-grid">
    <div class="where-head">
      <p class="eyebrow">Où et quand</p>
      <h2 class="h-1">Le samedi matin, de 9 h à 10 h.</h2>
      <p class="where-session">Session d'automne en cours — inscriptions ouvertes.</p>
    </div>
    <dl class="where-facts">
      <div>
        <dt>Adresse</dt>
        <dd>2376, rue Galvani<br />Québec (QC) G1N 4G4</dd>
      </div>
      <div>
        <dt>Téléphone</dt>
        <dd><a href="tel:+15818884616">(581) 888-4616</a></dd>
      </div>
      <div>
        <dt>Stationnement</dt>
        <dd>Ample, sur place</dd>
      </div>
    </dl>
    <div class="where-maps">
      <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost">
        Voir sur Google Maps
      </a>
    </div>
  </div>
</section>

<style>
  .where {
    border-block: 1px solid var(--line);
  }
  .where-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr auto;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .where-head .h-1 {
    margin-top: 14px;
  }
  .where-session {
    margin-top: 16px;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--accent-ink);
    background: var(--accent-tint);
    border: 1px solid color-mix(in oklab, var(--accent) 30%, transparent);
    border-radius: 999px;
    padding: 6px 14px;
  }
  .where-facts {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .where-facts div {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
  }
  .where-facts dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .where-facts dd {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 16px;
  }
  .where-facts a {
    color: inherit;
  }
  @media (max-width: 860px) {
    .where-grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 28px;
    }
    .where-facts {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 560px) {
    .where-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
