---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">BJJ</span>
      <div>
        <p class="footer-name">BJJ Québec Enfants</p>
        <p class="footer-city">Québec, Canada</p>
      </div>
    </div>
    <nav class="footer-nav" aria-label="Navigation de pied de page">
      <a href="#programmes">Programmes</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>
    <p class="footer-copy">© {year} BJJ Québec Enfants. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--dark-ink);
    padding-block: 44px;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
  }
  .brand-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    background: var(--dark-ink);
    color: var(--dark);
    padding: 7px 9px 6px;
    border-radius: 8px 8px 8px 2px;
  }
  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
  }
  .footer-city {
    font-size: 13px;
    opacity: 0.7;
  }
  .footer-nav {
    display: flex;
    gap: 20px;
  }
  .footer-nav a {
    font-size: 14px;
    text-decoration: none;
    opacity: 0.85;
  }
  .footer-nav a:hover {
    opacity: 1;
  }
  .footer-copy {
    width: 100%;
    font-size: 12.5px;
    opacity: 0.6;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in oklab, var(--dark-ink) 18%, transparent);
  }
</style>
